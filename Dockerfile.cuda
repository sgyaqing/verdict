# Verdict serving image (CUDA): base image plus one layer, the binary.
# Build (docker/release.sh chains both steps; full source build:
# Dockerfile.build.cuda):
#   docker buildx build -f Dockerfile.build.cuda --target verdict-bin \
#       --output type=local,dest=bin/ .
#   docker buildx build -f Dockerfile.cuda --build-context bin=bin \
#       --platform linux/amd64 --build-arg VERSION=<ver> --build-arg REVISION=<sha> \
#       -t <ns>/verdict:<ver>-cuda --load .
# Run:  docker run --gpus all -p 8080:8080 -v $PWD/<model-dir>:/model:ro \
#           verdict:<ver>-cuda
# --gpus all is not optional: without the host's NVIDIA runtime the engine
# finds no CUDA and quietly serves on CPU.

# Move BASE together with the dependency pins (rebuilt by Dockerfile.base-cuda).
ARG BASE=sgyaqing/verdict:base-0.2-cuda
FROM ${BASE}

# No maintainer/author labels.
ARG VERSION=0.0.0
ARG REVISION=
LABEL org.opencontainers.image.title="Verdict (CUDA)" \
      org.opencontainers.image.description="A high-performance serving engine for System One decision models (CUDA execution provider + torch runtime)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="https://github.com/sgyaqing/verdict" \
      org.opencontainers.image.url="https://github.com/sgyaqing/verdict" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY --from=bin /verdict /usr/local/bin/verdict
