# Verdict serving image (CUDA): the CPU image plus (a) an onnxruntime built
# for the CUDA execution provider with its CUDA libraries, and (b) the pinned
# python torch stack the "runtime":"torch" packages execute through.
#
# Build (the ~1.5 GB wheel set arrives as a named context so it never enters
# the main build context):
#   docker buildx build -f Dockerfile.cuda \
#     --build-context cudawheels=<wheel-dir> \
#     --platform linux/amd64 -t <ns>/verdict:0.2.0-cuda --load .
#
# The wheel set is onnxruntime-gpu 1.30.0 plus its [cuda,cudnn] nvidia-*
# dependencies, all cp312/py3-none manylinux x86_64 -- seven wheels in total.
# cuBLAS is in neither of onnxruntime-gpu's extras and must be pinned
# separately, or the image links an onnxruntime that cannot find libcublas.
# To resolve the set yourself, query the PyPI JSON API for each package and
# take the matching wheel from a mirror.
# Run:  docker run --gpus all -p 8080:8080 -v $PWD/<model-dir>:/model:ro \
#           verdict:0.2.0-cuda
#
# `--gpus all` is not optional: without the host's NVIDIA runtime injecting
# the driver, the engine finds no CUDA and quietly serves on CPU.
# The torch stage downloads ~3 GB from download.pytorch.org at build time.

# ---- extract the CUDA library set from the wheels ------------------------
FROM debian:trixie-slim AS cuda
# Every apt stage in this file needs the mirror redirect spelled out: a global
# ARG declared before the first FROM reaches only the FROM lines, not the
# stages. Unset APT_MIRROR keeps the stock sources.
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
      for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources; do \
        [ -f "$f" ] && sed -i "s|deb.debian.org|$APT_MIRROR|g" "$f"; \
      done; \
    fi
RUN apt-get update && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=cudawheels / /tmp/wheels/
RUN set -eux; \
    mkdir -p /ort /cudalibs; \
    unzip -j -o /tmp/wheels/onnxruntime_gpu-*.whl 'onnxruntime/capi/libonnxruntime*.so*' -d /ort; \
    for w in /tmp/wheels/nvidia_*.whl; do \
      unzip -j -o "$w" 'nvidia/*/lib/*.so*' -d /cudalibs; \
    done; \
    ls -l /ort; echo "cuda libs: $(ls /cudalibs | wc -l)"; \
    # Wildcards on purpose (names change between versions); the test -f pair
    # below is what fails the build when a provider library goes missing --
    # a session whose CUDA provider is absent starts fine and runs on CPU.
    test -f /ort/libonnxruntime_providers_cuda.so; \
    test -f /ort/libonnxruntime_providers_shared.so

# ---- torch runtime stack (pinned versions) ----
# The torch executor (runtime "torch" packages) spawns `python3.12` with
# exactly this stack. Pins are load-bearing: the executor's kernels (fla /
# triton) and the bf16 numerics were validated against these builds --
# float freely and the graded tolerances no longer describe the artifact.
FROM python:3.12-slim-trixie AS torch
RUN pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/cu130 \
      torch==2.14.1+cu130 \
      triton==3.8.0 \
      transformers==5.19.0 \
      flash-linear-attention==0.5.2 \
      fla-core==0.5.2

# ---- causal-conv1d (built on top of the pinned torch stage) -------------
# transformers' Qwen3.5 path falls back to a reference conv without this
# kernel (about 10% slower forward time with it enabled). PyPI ships only an
# sdist, so it compiles here -- against this same
# torch. Built FROM `torch` rather than from a bare python image so the
# runtime stack is installed once; this stage's layers (nvcc, headers, the
# build tree) never reach the final image.
FROM torch AS cc1build
# APT_MIRROR redirects apt without changing the default behaviour for
# everyone else. Same shape as PIP_INDEX_URL on the cpu image.
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
      for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources; do \
        [ -f "$f" ] && sed -i "s|deb.debian.org|$APT_MIRROR|g" "$f"; \
      done; \
    fi
COPY docker/cc1_build.sh /tmp/cc1_build.sh
RUN bash /tmp/cc1_build.sh

# Named stage on purpose: the runtime below copies site-packages from HERE.
# An anonymous `FROM torch` would install the wheel into a stage nothing
# references -- the build still succeeds and the image silently lacks the
# kernel (hit once, 2026-10-15).
FROM torch AS torch_final
COPY --from=cc1build /wheels/causal_conv1d-*.whl /tmp/
RUN python -c "import zipfile,glob; zipfile.ZipFile(glob.glob('/tmp/causal_conv1d-*.whl')[0]).extractall('/tmp/cc1check')" \
    && python -c "import sys; sys.path.insert(0,'/tmp/cc1check'); import causal_conv1d; print('wheel importable')" \
    && rm -rf /tmp/cc1check
RUN pip install --no-cache-dir /tmp/causal_conv1d-*.whl \
    && python -c "import causal_conv1d; print('installed', causal_conv1d.__version__)" \
    && rm -f /tmp/causal_conv1d-*.whl

# ---- builder (same shape as the CPU image) -------------------------------
FROM rust:1.90-slim AS builder
WORKDIR /build

# CARGO_MIRROR=<sparse index> routes cargo through a mirror.
ARG CARGO_MIRROR=""
RUN if [ -n "$CARGO_MIRROR" ]; then \
      printf '[source.crates-io]\nreplace-with = "mirror"\n\n[source.mirror]\nregistry = "%s"\n' \
        "$CARGO_MIRROR" > "${CARGO_HOME:-/usr/local/cargo}/config.toml"; \
    fi

# g++ (cc-rs builds C/C++); its own RUN above the COPYs so src-only changes
# reuse the cached layer.
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
      for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources; do \
        [ -f "$f" ] && sed -i "s|deb.debian.org|$APT_MIRROR|g" "$f"; \
      done; \
    fi
RUN apt-get update && apt-get install -y --no-install-recommends g++ \
    && rm -rf /var/lib/apt/lists/*
# only the manifest + src are needed.
COPY Cargo.toml Cargo.lock ./
COPY src ./src
# `src/torch_engine.rs` embeds the python executor with `include_str!`, so the
# file must exist at compile time. Exact path, not `COPY executor ./executor`
# -- the directory also holds a local __pycache__ that has no place in an image.
COPY executor/torch_exec.py ./executor/torch_exec.py
# Cache mounts survive across builds, so src-only changes recompile only
# this crate. Mount contents are NOT in the layer snapshot: the binary must
# be copied out in the SAME RUN -- a later COPY of target/ fails "not found".
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --release && cp target/release/verdict ./verdict

# ---- runtime ------------------------------------------------------------
# python:3.12-slim-trixie (not debian:trixie-slim): the torch executor
# spawns python3.12, and trixie keeps the glibc generation matching the
# builder (a bookworm base fails with GLIBC_2.38-not-found).
FROM python:3.12-slim-trixie

# No maintainer/author fields: published artifacts carry no personal
# identifiers. VERSION/REVISION come from the build script.
ARG VERSION=0.0.0
ARG REVISION=
LABEL org.opencontainers.image.title="Verdict (CUDA)" \
      org.opencontainers.image.description="A high-performance serving engine for System One decision models (CUDA execution provider + torch runtime)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="https://github.com/sgyaqing/verdict" \
      org.opencontainers.image.url="https://github.com/sgyaqing/verdict" \
      org.opencontainers.image.licenses="Apache-2.0"

# The C toolchain is a runtime dependency, not a build one: triton JITs the
# fla kernels on first use and shells out to a compiler. build-essential, not
# gcc -- the C standard headers come from libc6-dev, a separate package, so
# `gcc` alone compiles nothing that includes <stdlib.h> and triton fails with
# "fatal error: stdlib.h: No such file or directory". Neither failure shows up
# at build time; both were caught by validating the image, so keep this
# labelled as the toolchain, not as a compiler.
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
      for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources; do \
        [ -f "$f" ] && sed -i "s|deb.debian.org|$APT_MIRROR|g" "$f"; \
      done; \
    fi
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 build-essential \
    && rm -rf /var/lib/apt/lists/*

# Tells the NVIDIA container runtime what to inject (the pair nvidia/cuda
# base images set).
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /app
COPY --from=builder /build/verdict /usr/local/bin/verdict
# Ship everything the wheel's capi/ carries, including the EP plugins it
# loads by soname: without providers_cuda.so the provider never loads and
# the engine serves on CPU.
COPY --from=cuda /ort/ /usr/local/lib/
COPY --from=cuda /cudalibs/ /usr/local/lib/
RUN ln -s libonnxruntime.so.1.30.0 /usr/local/lib/libonnxruntime.so \
    && ldconfig
# The torch executor stack (self-contained under site-packages; torch finds
# its bundled CUDA libs by rpath, no ldconfig needed for these). From
# torch_final, not torch: the latter is the pre-cc1 stage.
COPY --from=torch_final /usr/local/lib/python3.12/site-packages \
     /usr/local/lib/python3.12/site-packages

VOLUME /model
EXPOSE 8080
ENTRYPOINT ["verdict"]
CMD ["serve", "/model", "--host", "0.0.0.0", "--port", "8080"]
