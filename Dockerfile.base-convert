# Verdict convert base image: the pinned export stack. Frozen by design --
# bumping any pin re-anchors byte-identical exports (see design/CONVERT.md).
# The wheels are pre-downloaded on the host into cv-wheels/ because container
# egress to the pip mirrors crawls at ~60 KB/s on some hosts while the host
# itself pulls at full speed; --no-index makes the build hermetic.
#
# Build (host prepares the wheels first):
#   pip download -d cv-wheels -i $PYPI_MIRROR --find-links $TORCH_MIRROR \
#     torch==2.14.1+cpu transformers==5.19.0 tokenizers==0.23.2 \
#     safetensors==0.8.0 onnx==1.23.2 onnxscript==0.7.2 \
#     onnxruntime==1.30.0 von-sdk==1.3.7 laya==0.3.28
#   docker build -f Dockerfile.base-convert -t sgyaqing/verdict:base-0.4-convert .

FROM python:3.12-slim-trixie

COPY cv-wheels/ /wheels/

RUN pip install --no-cache-dir --no-index --find-links=/wheels \
      torch==2.14.1+cpu \
      transformers==5.19.0 \
      tokenizers==0.23.2 \
      safetensors==0.8.0 \
      onnx==1.23.2 \
      onnxscript==0.7.2 \
      onnxruntime==1.30.0 \
      von-sdk==1.3.7 \
      laya==0.3.28

# The engine dlopens libonnxruntime at serve time; the python wheel already
# carries the exact pinned build -- expose it on the loader path the same way
# the cpu base image does.
RUN so=$(python3.12 -c "import onnxruntime, os; print(os.path.join(os.path.dirname(onnxruntime.__file__), 'capi', 'libonnxruntime.so.1.30.0'))") \
    && cp "$so" /usr/local/lib/ \
    && ln -s libonnxruntime.so.1.30.0 /usr/local/lib/libonnxruntime.so \
    && ldconfig

WORKDIR /workspace
ENTRYPOINT ["python3.12"]
